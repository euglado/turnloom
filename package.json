{
  "name": "turnloom",
  "version": "1.0.0",
  "private": true,
  "description": "A low-permission Discord speaking-turn queue",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run lint && npm test && node scripts/check-supply.mjs",
    "setup": "node scripts/setup.mjs",
    "register": "node --env-file=.env dist/register.js",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
